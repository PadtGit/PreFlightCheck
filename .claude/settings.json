{
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cat:*)",
      "Bash(which:*)",
      "Bash(readlink:*)",
      "Bash(pwsh -NoProfile -Command Invoke-Pester:*)",
      "Bash(pwsh -NoProfile -File ./tools/Invoke-FullScriptAnalysis.ps1:*)",
      "PowerShell(Invoke-Pester:*)",
      "PowerShell(./tools/Invoke-FullScriptAnalysis.ps1:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoLogo -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/Block-LiveMaintenance.ps1\""
          }
        ]
      }
    ]
  }
}
